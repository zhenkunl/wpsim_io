# Add flag for different compilers
if(CMAKE_Fortran_COMPILER_ID MATCHES "GNU")
    set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -fconvert=big-endian -frecord-marker=4 -ffree-line-length-none")
    if(CMAKE_BUILD_TYPE MATCHES Debug)
        set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -g -O0 -Wall -Wextra -fbacktrace -fcheck=all")
    else()
        set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -O3 -Wall -Wextra")
    endif()
elseif(CMAKE_Fortran_COMPILER_ID MATCHES "NVHPC" OR CMAKE_Fortran_COMPILER_ID MATCHES "PGI")
    set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -byteswapio -Mextend")
    if(CMAKE_BUILD_TYPE MATCHES Debug)
        set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -g -O0 -Mbounds -Mchkptr -Ktrap=fp")
    else()
        set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -O3")
    endif()
elseif(CMAKE_Fortran_COMPILER_ID MATCHES "^Intel") # ifort, ifx
    set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -convert big_endian")
    if(CMAKE_BUILD_TYPE MATCHES Debug)
        set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -g -O0 -traceback -check all -fpe0")
    else()
        set(CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS} -O3")
    endif()
endif()